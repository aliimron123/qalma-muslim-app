{
	"expo": {
		"android": {
			"adaptiveIcon": {
				"backgroundColor": "#E5E7EB",
				"foregroundImage": "./assets/images/adaptive-icon.png"
			},
			"edgeToEdgeEnabled": true
		},
		"experiments": {
			"typedRoutes": true
		},
		"icon": "./assets/images/icon.png",
		"ios": {
			"supportsTablet": true
		},
		"name": "al-quran-v2",
		"newArchEnabled": true,
		"orientation": "portrait",
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"backgroundColor": "#ffffff",
					"image": "./assets/images/splash-icon.png",
					"imageWidth": 200,
					"resizeMode": "contain"
				}
			],
			"expo-sqlite"
		],
		"scheme": "alquranv2",
		"slug": "al-quran-v2",
		"userInterfaceStyle": "light",
		"version": "1.0.0",
		"web": {
			"bundler": "metro",
			"favicon": "./assets/images/favicon.png",
			"output": "static"
		}
	}
}
